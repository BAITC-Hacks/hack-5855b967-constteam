# Скопируйте в .env и впишите СВОЙ ключ. Файл .env не попадает в Git.
# Никогда не отправляйте ключ в чат, мессенджер или репозиторий.
# Без ключа подбор работает, агент не запускается (резервный режим).

# Провайдер: openai или anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=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
ANTHROPIC_API_KEY=

# Модель агента. Пусто — по умолчанию: gpt-4o-mini (openai) или claude-haiku-4-5-20251001 (anthropic)
LLM_MODEL= gpt-4.1-mini
# Общий бюджет времени агента на запрос, секунд
AGENT_DEADLINE=9
# 0 — отключить агента
LLM_ENABLED=1
